# === AI Story Studio Config ===

# LLM
LLM_MODEL_PATH=models/llm/qwen2.5-7b-instruct-q4_k_m.gguf
LLM_N_GPU_LAYERS=28
LLM_CONTEXT_SIZE=8192
LLM_TEMPERATURE=0.8

# ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_DIR=comfyui/workflows
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_STEPS=30
IMAGE_CFG=7.5

# TTS
TTS_MODEL_PATH=models/tts/F5-TTS
TTS_LANGUAGE=es

# FFmpeg
FFMPEG_PATH=ffmpeg
OUTPUT_DIR=output

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./ai_story_studio.db